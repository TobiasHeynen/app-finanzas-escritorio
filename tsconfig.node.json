{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node", "vite/client"],
    "paths": {
      "@shared/*": ["./packages/core/src/shared/*"],
      "@core/*": ["./packages/core/src/*"],
      "@main/*": ["./src/main/*"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "packages/core/src/**/*",
    "tests/**/*",
    "scripts/*.d.mts"
  ]
}
